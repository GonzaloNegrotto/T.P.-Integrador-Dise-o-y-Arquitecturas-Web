# Copia de referencia del .env (sin valores reales).
# Duplicar como .env y completar con las credenciales de TMDB.
API_READ_ACCESS_TOKEN=
API_KEY=
DATABASE_URL=
# Clave aleatoria larga para firmar las sesiones del servidor.
SECRET_KEY=
# Chatbot (opcional): key de Google AI Studio para responder con Gemini.
# Sin key, el chatbot responde por reglas con datos de TMDB.
CHATBOT_API_KEY=
# Opcional: otro modelo de Gemini (por defecto gemini-3.5-flash-lite).
CHATBOT_MODELO=
